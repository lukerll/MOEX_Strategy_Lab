# Скопируйте в .env и заполните нужное.

# Провайдер модели из configs/providers.yaml: gigachat | openrouter | groq | zai | ollama
MSA_PROVIDER=gigachat

# Источник котировок: moex (живой ISS с кешем) | demo (синтетика без сети)
MSA_DATA_MODE=moex

# Ключи провайдеров (нужен только ключ активного).
# GIGACHAT_AUTH_KEY: «Ключ авторизации» из личного кабинета developers.sber.ru (длинная строка base64).
# Этот файл не отправляйте никому и не коммитьте: .env есть в .gitignore.
GIGACHAT_AUTH_KEY=
# Путь к сертификату НУЦ Минцифры, если Python ругается на SSL (см. README)
GIGACHAT_CA_BUNDLE=
OPENROUTER_API_KEY=
GROQ_API_KEY=
ZAI_API_KEY=

# Если задан, все запросы к /api/* требуют заголовок X-API-Key
MSA_API_KEY=

# Необязательно: ссылка «Личный кабинет» в настройках, по умолчанию developers.sber.ru/studio
# GIGACHAT_STUDIO_URL=https://developers.sber.ru/studio/workspaces/ваш_id
